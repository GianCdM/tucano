// The site is served by Cloudflare as static files (no Worker code runs):
//   cd site && npx wrangler deploy
{
  "name": "tucano-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "." },
  "routes": [
    { "pattern": "tucano.sh", "custom_domain": true },
    { "pattern": "www.tucano.sh", "custom_domain": true }
  ]
}
